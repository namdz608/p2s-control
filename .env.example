# ./start.sh tạo APP_PASSWORD_BASE64 từ mật khẩu nhập ẩn.
# Có thể dùng APP_PASSWORD trong file .env thay cho APP_PASSWORD_BASE64.
# Mật khẩu tối thiểu 8 ký tự. Không chia sẻ hoặc commit file .env.
APP_PASSWORD_BASE64=
APP_PORT=3080
BIND_ADDRESS=0.0.0.0
# Khi dùng HTTPS qua reverse proxy hoặc Tailscale Serve:
SECURE_COOKIES=false
# Để trống nếu proxy giữ nguyên Host. Nếu cần, điền đúng origin HTTPS:
PUBLIC_ORIGIN=
